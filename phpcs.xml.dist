<?xml version="1.0"?>
<ruleset name="Sprint Engine">
  <description>WordPress standards for SE-001 runtime code.</description>
  <file>sprint-engine.php</file>
  <file>uninstall.php</file>
  <file>src</file>
  <file>templates</file>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <rule ref="WordPress">
    <!-- Class filenames follow the authoritative specification's structure. -->
    <exclude name="WordPress.Files.FileName"/>
  </rule>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array"><element value="sprint-engine"/></property>
    </properties>
  </rule>
</ruleset>
